    "%USERPROFILE%\\Desktop",
    "%USERPROFILE%\\Downloads",
    "C:\\Program Files",
    "C:\\Program Files (x86)"
  ],
  "search_max_depth": 4,
  "report": {
    "output_dir": "C:\\Users\\Public\\Documents\\DTT whitelist validation report",
    "formats": [
